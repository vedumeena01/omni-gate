# ==============================================================================
# OmniGate Environment Configuration
# ==============================================================================

# Application Settings
OMNIGATE_APP_NAME=OmniGate
OMNIGATE_APP_ENV=development
OMNIGATE_HOST=0.0.0.0
OMNIGATE_PORT=8000
OMNIGATE_DEBUG=false
# Optional: Set master API key to enforce client authorization header
# OMNIGATE_MASTER_API_KEY=sk-omni-gateway-master-key-xyz

# Caching Configuration
OMNIGATE_CACHE_ENABLED=true
OMNIGATE_EXACT_CACHE_TTL_SECONDS=3600
OMNIGATE_EXACT_CACHE_MAX_SIZE=10000
OMNIGATE_SEMANTIC_CACHE_ENABLED=true
OMNIGATE_SEMANTIC_SIMILARITY_THRESHOLD=0.85

# Guardrails Configuration
OMNIGATE_GUARDRAILS_ENABLED=true
OMNIGATE_PII_MASKING_ENABLED=true
OMNIGATE_INJECTION_DETECTION_ENABLED=true
OMNIGATE_BLOCK_ON_INJECTION=true

# Resilience: Rate Limiter & Circuit Breaker
OMNIGATE_RATE_LIMIT_ENABLED=true
OMNIGATE_DEFAULT_REQUESTS_PER_MINUTE=60
OMNIGATE_DEFAULT_BURST_CAPACITY=10
OMNIGATE_FAILURE_THRESHOLD=3
OMNIGATE_RECOVERY_TIMEOUT_SECONDS=30.0
OMNIGATE_HALF_OPEN_SUCCESS_THRESHOLD=2

# Upstream LLM Provider Settings
OMNIGATE_DEFAULT_MODEL=mock-gpt-4o
OMNIGATE_FALLBACK_MODEL=mock-gpt-3.5-turbo
# If using real OpenAI API, provide your key and upstream base URL:
# OMNIGATE_UPSTREAM_OPENAI_BASE_URL=https://api.openai.com/v1
# OMNIGATE_UPSTREAM_OPENAI_API_KEY=sk-proj-your-real-api-key
OMNIGATE_TIMEOUT_SECONDS=30.0
OMNIGATE_MAX_RETRIES=2
